# Application settings
ATEAM_LOG_LEVEL=INFO
ATEAM_MAX_RETRIES=2

# Provider selections are names, not vendor-specific implementations.
# v0.1 does not make external model calls.
ATEAM_ORCHESTRATOR_PROVIDER=unconfigured
ATEAM_ENGINEER_PROVIDER=unconfigured
ATEAM_REVIEWER_PROVIDER=unconfigured

# To enable live model calls, set all three provider values to "openai".
# ATEAM_ORCHESTRATOR_PROVIDER=openai
# ATEAM_ENGINEER_PROVIDER=openai
# ATEAM_REVIEWER_PROVIDER=openai
# ATEAM_OPENAI_MODEL=gpt-6-astra
# Put your real key in the ignored .env file. Never commit it.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

